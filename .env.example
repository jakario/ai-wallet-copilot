# Server-Side API Keys (NEVER expose to client with NEXT_PUBLIC_)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Priority 1: ChainOpera Unified Model API (Primary AI Engine post-grant)
# CHAINOPERA_API_KEY=your_chainopera_api_key_here
CHAINOPERA_API_BASE_URL=https://api.chainopera.ai/v1
CHAINOPERA_MODEL=gpt-4o-mini

# Priority 2: Groq API (Active free-tier baseline)
GROQ_API_KEY=your_groq_api_key_here

# Priority 3: Optional alternative AI Engine (Google AI Studio / Vertex AI)
# GEMINI_API_KEY=your_gemini_api_key_here

# Public Web3 Configuration (BNB Smart Chain - Chain ID 56)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
NEXT_PUBLIC_COAI_TOKEN_ADDRESS=0x0a8d6c86e1bce73fe4d0bd531e1a567306836ea5
NEXT_PUBLIC_COAI_THRESHOLD=10
NEXT_PUBLIC_APP_URL=http://localhost:3000
